# Copy to .env — used by docker-compose and local development.

# Required for the map. Free tier: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Database connection (host is `db` inside Docker; the compose db is published
# on host port 5434 to avoid clashing with a system PostgreSQL on 5432)
DATABASE_URL=postgres://geo:geo@localhost:5434/geo

# Server
PORT=4000
USGS_POLL_INTERVAL_MIN=5

# ETL seed window
USGS_DAYS=30
USGS_MIN_MAG=2.5
